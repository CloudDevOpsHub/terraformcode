terraform {
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 6.0"
    }
  }
}

provider "aws" {
  region = "ap-south-1"
}

variable "users" {
  type = list(string)

  default = [
    "shadab-user1",
    "chander-user2",
    "shalini-user3",
    "ankit-user4",
    "junaid-user5"
  ]
}

resource "aws_iam_user" "users" {
  count = length(var.users)

  name = var.users[count.index]

  tags = {
    ManagedBy = "Terraform"
  }
}

output "iam_users" {
  value = aws_iam_user.users[*].name
}
